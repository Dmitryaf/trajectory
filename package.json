{
  "name": "trajectory-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "demo:generate": "node scripts/generate-demo-data.mjs",
    "predev": "npm run demo:generate",
    "dev": "vite",
    "prebuild": "npm run demo:generate",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "pretest:e2e": "npm run demo:generate",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "echarts": "^6.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.8"
  }
}
